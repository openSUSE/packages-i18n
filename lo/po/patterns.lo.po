msgid "WSL GUI packages"
msgstr "ແພັກເກັດ WSL GUI"

#. SLE/patterns-wsl/patterns-wsl-gui/description
msgid ""
"This package contains the wsl_gui pattern: recommended tools,libraries for "
"using WSLg."
